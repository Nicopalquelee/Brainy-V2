# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portal

# App
PORT=3000
JWT_SECRET=changeme
BASE_PUBLIC_URL=http://localhost:3000

# Si SKIP_DB=true la aplicación no intentará conectar a la base de datos (útil para ver Swagger sin DB)
SKIP_DB=false

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# CORS
CORS_ORIGIN=*
